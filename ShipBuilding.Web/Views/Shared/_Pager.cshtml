@model PagingInfo

@if (Model.TotalItems > 0)
{
    <nav class="d-flex align-items-center flex-wrap gap-2 mt-3" aria-label="@PaginationCaption">
        <span class="text-muted small">
            @string.Format(ShownRecordsFormat, Model.FirstItemNumber, Model.LastItemNumber, Model.TotalItems)
        </span>

        @if (Model.TotalPages > 1)
        {
            <ul class="pagination pagination-sm mb-0 ms-auto">
                <li class="page-item @(Model.HasPreviousPage ? "" : "disabled")">
                    @if (Model.HasPreviousPage)
                    {
                        <a class="page-link" asp-route-page="@(Model.CurrentPage - 1)" aria-label="@PreviousPageCaption">&laquo;</a>
                    }
                    else
                    {
                        <span class="page-link" aria-hidden="true">&laquo;</span>
                    }
                </li>

                @foreach (var number in Model.GetPageNumbers())
                {
                    @* змінна не може називатись page: @page — директива Razor *@
                    if (number is int pageNumber)
                    {
                        if (pageNumber == Model.CurrentPage)
                        {
                            <li class="page-item active" aria-current="page"><span class="page-link">@pageNumber</span></li>
                        }
                        else
                        {
                            <li class="page-item"><a class="page-link" asp-route-page="@pageNumber">@pageNumber</a></li>
                        }
                    }
                    else
                    {
                        <li class="page-item disabled"><span class="page-link">…</span></li>
                    }
                }

                <li class="page-item @(Model.HasNextPage ? "" : "disabled")">
                    @if (Model.HasNextPage)
                    {
                        <a class="page-link" asp-route-page="@(Model.CurrentPage + 1)" aria-label="@NextPageCaption">&raquo;</a>
                    }
                    else
                    {
                        <span class="page-link" aria-hidden="true">&raquo;</span>
                    }
                </li>
            </ul>
        }
    </nav>
}

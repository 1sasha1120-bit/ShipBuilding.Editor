@model ShipBuilding.Web.ViewModels.Shipyards.ShipyardEditingViewModel
@{ ViewData["Title"] = ShipyardDetailsTitle; }

@section Styles {
    <link rel="stylesheet" href="~/css/entity.css" asp-append-version="true" />
}

<div class="entity-card entity-card--lg">
    <div class="entity-card-header">
        <span class="entity-icon"><i class="fa-solid fa-industry"></i></span>
        <div>
            <h1>@Model.Name</h1>
            <div class="entity-subtitle">@ShipyardDetailsSubtitle</div>
        </div>
    </div>
    <div class="entity-card-body">
        <div class="detail-grid">
            <div class="detail-label">@NameCaption</div>
            <div class="detail-value">@Model.Name</div>

            <div class="detail-label">@CountryCaption</div>
            <div class="detail-value">@(Model.CountryName ?? "—")</div>

            <div class="detail-label">@YearOfFoundedCaption</div>
            <div class="detail-value">@(Model.YearOfFounded?.ToString() ?? "—")</div>

            <div class="detail-label">@NumberOfDocksCaption</div>
            <div class="detail-value">@(Model.NumberOfDocks?.ToString() ?? "—")</div>

            <div class="detail-label">@CapacityPerYearCaption</div>
            <div class="detail-value">
                @if (Model.CapacityPerYear.HasValue)
                { <span>@Model.CapacityPerYear.Value.ToString("N0") @TonnesUnit</span> }
                else { <span class="text-muted">—</span> }
            </div>
        </div>

        <div class="entity-actions">
            <partial name="_ActionButton" model="ActionButtonViewModel.EditLink(Model.Id)" />
            <partial name="_ActionButton" model="ActionButtonViewModel.DeleteLink(Model.Id)" />
            <a asp-action="Index" class="btn-back">@BackToListCaption</a>
        </div>
    </div>
</div>

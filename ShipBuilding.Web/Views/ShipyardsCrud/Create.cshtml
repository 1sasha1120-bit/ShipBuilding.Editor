@model ShipBuilding.Web.Models.ShipyardModels.ShipyardEditingModel
@{ ViewData["Title"] = "Новий завод"; }

@section Styles {
    <link rel="stylesheet" href="~/css/entity.css" asp-append-version="true" />
}

<div class="entity-card entity-card--sm">
    <div class="entity-card-header">
        <span class="entity-icon"><i class="fa-solid fa-industry"></i></span>
        <div>
            <h1>Новий завод</h1>
            <div class="entity-subtitle">Заповніть поля та збережіть</div>
        </div>
    </div>
    <div class="entity-card-body">
        <form asp-action="Create" class="entity-form">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 mb-3 validation-summary"></div>
            <div class="mb-3">
                <label asp-for="Name"></label>
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="text-danger small"></span>
            </div>
            <div class="mb-3">
                <label asp-for="CountryName"></label>
                <input asp-for="CountryName" class="form-control" />
                <span asp-validation-for="CountryName" class="text-danger small"></span>
            </div>
            <div class="row">
                <div class="col-sm-6 mb-3">
                    <label asp-for="YearOfFounded"></label>
                    <input asp-for="YearOfFounded" type="number" class="form-control" />
                    <span asp-validation-for="YearOfFounded" class="text-danger small"></span>
                </div>
                <div class="col-sm-6 mb-3">
                    <label asp-for="NumberOfDocks"></label>
                    <input asp-for="NumberOfDocks" type="number" class="form-control" />
                    <span asp-validation-for="NumberOfDocks" class="text-danger small"></span>
                </div>
            </div>
            <div class="mb-3">
                <label asp-for="CapacityPerYear"></label>
                <input asp-for="CapacityPerYear" step="any" type="number" class="form-control" />
                <span asp-validation-for="CapacityPerYear" class="text-danger small"></span>
            </div>
            <div class="entity-actions">
                <partial name="_ActionButton" model="ActionButtonModel.CreateSubmit()" />
                <a asp-action="Index" class="btn-back">← Назад до списку</a>
            </div>
        </form>
    </div>
</div>

@model ShipBuilding.Web.ViewModels.Shipyards.ShipyardDeletingViewModel
@{ ViewData["Title"] = ShipyardDeleteTitle; }

@section Styles {
    <link rel="stylesheet" href="~/css/entity.css" asp-append-version="true" />
}

<div class="entity-card entity-card--sm">
    <div class="entity-card-header">
        <span class="entity-icon"><i class="bi bi-trash"></i></span>
        <div>
            <h1>@DeleteShipyardHeader</h1>
            <div class="entity-subtitle">@Model.Name</div>
        </div>
    </div>
    <div class="entity-card-body">
        @if (TempData["error"] != null)
        {
            <div class="alert alert-danger" role="alert">
                @TempData["error"]
            </div>
        }
        <div class="delete-warning"><i class="bi bi-exclamation-triangle"></i> @DeleteWarningMessage</div>

        <div class="detail-grid">
            <div class="detail-label">@NameCaption</div>
            <div class="detail-value">@Model.Name</div>
            <div class="detail-label">@CountryCaption</div>
            <div class="detail-value">@(Model.CountryName ?? "—")</div>
            <div class="detail-label">@YearOfFoundedCaption</div>
            <div class="detail-value">@(Model.YearOfFounded?.ToString() ?? "—")</div>
            <div class="detail-label">@NumberOfDocksCaption</div>
            <div class="detail-value">@(Model.NumberOfDocks?.ToString() ?? "—")</div>
            <div class="detail-label">@CapacityPerYearCaption</div>
            <div class="detail-value">@(Model.CapacityPerYear?.ToString() ?? "—")</div>
        </div>

        <form asp-action="Delete">
            <input type="hidden" asp-for="Id" />
            <div class="entity-actions">
                <partial name="_ActionButton" model="ActionButtonViewModel.DeleteSubmit()" />
                <a asp-action="Index" class="btn btn-outline-secondary">@CancelCaption</a>
            </div>
        </form>
    </div>
</div>

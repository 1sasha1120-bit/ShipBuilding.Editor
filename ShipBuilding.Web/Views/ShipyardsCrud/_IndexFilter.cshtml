@using ShipBuilding.Web.Models.ShipyardModels
@model ShipBuilding.Web.Models.ShipyardModels.ShipyardsFilter

<form asp-action="Index" method="get">
    <table class="table">
        <thead>
            <tr>
                <th>
                    @Html.DisplayNameFor(model => model.Name)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.CountryName)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.YearOfFoundedFrom)
                </th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            <tr>
                <td>
                    <input asp-for="Name" class="form-control" />
                </td>
                <td>
                    <input asp-for="CountryName" class="form-control" />
                </td>
                <td>
                    @RangeFromCaption <input asp-for="YearOfFoundedFrom" class="form-control" /><br />
                    @RangeToCaption <input asp-for="YearOfFoundedTo" class="form-control" />
                </td>
                <td>
                    <button type="submit" class="btn btn-primary">@SearchCaption</button>
                    <a asp-action="Index" class="btn btn-outline-secondary">@ClearCaption</a>
                </td>
            </tr>
        </tbody>
    </table>
</form>

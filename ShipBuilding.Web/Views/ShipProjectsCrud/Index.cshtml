@model ShipBuilding.Web.ViewModels.ShipProjects.ShipProjectSelectionViewModel
@{ ViewData["Title"] = ProjectsHeader; }

@section Styles {
    <link rel="stylesheet" href="~/css/entity.css" asp-append-version="true" />
}

@if (TempData["message"] != null)
{
    <div class="alert alert-success alert-dismissible fade show">
        @TempData["message"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="d-flex align-items-center gap-3 mb-3">
    <h1 class="mb-0"><i class="fa-solid fa-compass-drafting"></i> @ProjectsHeader</h1>
    <partial name="_ActionButton" model='ActionButtonViewModel.CreateLink("btn-sm ms-auto")' />
    <a asp-controller="Admin" asp-action="Index" class="btn btn-outline-secondary btn-sm">@BackToAdminCaption</a>
</div>

<partial name="_IndexFilter" model="@Model.Filter" />

<div class="entity-card">
    <div class="entity-card-body p-0">
        <table class="table table-hover mb-0">
            <thead class="table-light">
                <tr>
                    <th><a asp-action="Index" asp-route-Name="@Model.Filter.Name" asp-route-ProjectCode="@Model.Filter.ProjectCode" asp-route-ShipyardName="@Model.Filter.ShipyardName" asp-route-sortBy="Name" asp-route-order="@Model.NextOrder("Name")" class="text-decoration-none text-dark fw-bold">@NameCaption <i class="bi bi-arrow-down-up"></i></a></th>
                    <th><a asp-action="Index" asp-route-Name="@Model.Filter.Name" asp-route-ProjectCode="@Model.Filter.ProjectCode" asp-route-ShipyardName="@Model.Filter.ShipyardName" asp-route-sortBy="ProjectCode" asp-route-order="@Model.NextOrder("ProjectCode")" class="text-decoration-none text-dark fw-bold">@ShortCodeCaption <i class="bi bi-arrow-down-up"></i></a></th>
                    <th><a asp-action="Index" asp-route-Name="@Model.Filter.Name" asp-route-ProjectCode="@Model.Filter.ProjectCode" asp-route-ShipyardName="@Model.Filter.ShipyardName" asp-route-sortBy="ShipyardName" asp-route-order="@Model.NextOrder("ShipyardName")" class="text-decoration-none text-dark fw-bold">@ShipyardCaption <i class="bi bi-arrow-down-up"></i></a></th>
                    <th><a asp-action="Index" asp-route-Name="@Model.Filter.Name" asp-route-ProjectCode="@Model.Filter.ProjectCode" asp-route-ShipyardName="@Model.Filter.ShipyardName" asp-route-sortBy="Budget" asp-route-order="@Model.NextOrder("Budget")" class="text-decoration-none text-dark fw-bold">@BudgetCaption <i class="bi bi-arrow-down-up"></i></a></th>
                    <th class="col-actions-170"></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.FilteredData)
                {
                    <tr>
                        <td class="fw-medium">@item.Name</td>
                        <td>
                            @if (!string.IsNullOrWhiteSpace(item.ProjectCode))
                            { <span class="field-badge">@item.ProjectCode</span> }
                            else { <span class="text-muted">—</span> }
                        </td>
                        <td>@(item.ShipyardName ?? "—")</td>
                        <td>@item.Budget?.ToString("C", new System.Globalization.CultureInfo("en-US"))</td>
                        <td>
                            <partial name="_RowActions" model="item.Id" />
                        </td>
                    </tr>
                }
                @if (!Model.FilteredData.Any())
                {
                    <tr>
                        <td colspan="5" class="text-center text-muted py-4">@NoProjectsFoundMessage</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

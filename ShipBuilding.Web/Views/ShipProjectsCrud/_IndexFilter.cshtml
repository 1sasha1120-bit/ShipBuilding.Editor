@using ShipBuilding.Web.Models.ShipProjectModels
@model ShipBuilding.Web.Models.ShipProjectModels.ShipProjectsFilter

<form asp-action="Index" method="get">
    <table class="table">
        <thead>
            <tr>
                <th>
                    @Html.DisplayNameFor(model => model.Name)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.ProjectCode)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.ShipyardName)
                </th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            <tr>
                <td>
                    <input type="text" name="Name" value="@Model.Name" class="form-control" />
                </td>
                <td>
                    <input type="text" name="ProjectCode" value="@Model.ProjectCode" class="form-control" />
                </td>
                <td>
                    <select name="ShipyardName" class="form-select" asp-items="@Model.ShipyardNamesList">
                        <option value="">-- Всі заводи --</option>
                    </select>
                </td>
                <td>
                    <button type="submit" class="btn btn-primary">Пошук</button>
                    <a asp-action="Index" class="btn btn-outline-secondary">Очистити</a>
                </td>
            </tr>
        </tbody>
    </table>
</form>

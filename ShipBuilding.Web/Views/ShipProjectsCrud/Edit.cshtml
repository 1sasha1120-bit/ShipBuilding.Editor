@model ShipBuilding.Web.ViewModels.ShipProjects.ShipProjectEditingViewModel
@{ ViewData["Title"] = ProjectEditTitle; }

@section Styles {
    <link rel="stylesheet" href="~/css/entity.css" asp-append-version="true" />
}

<div class="entity-card entity-card--sm">
    <div class="entity-card-header">
        <span class="entity-icon"><i class="bi bi-pencil-square"></i></span>
        <div>
            <h1>@EditProjectHeader</h1>
            <div class="entity-subtitle">@Model.Name</div>
        </div>
    </div>
    <div class="entity-card-body">
        <form asp-action="Edit" class="entity-form">
            <input type="hidden" asp-for="Id" />
            <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 mb-3 validation-summary"></div>
            <div class="mb-3">
                <label asp-for="Name"></label>
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="text-danger small"></span>
            </div>
            <div class="mb-3">
                <label asp-for="ProjectCode"></label>
                <input asp-for="ProjectCode" class="form-control input-w-200" placeholder="SP-2024-001" />
                <span asp-validation-for="ProjectCode" class="text-danger small"></span>
            </div>
            <div class="mb-3">
                <label asp-for="ShipyardName"></label>
                <select asp-for="ShipyardName" asp-items="@Model.ShipyardSelectList" class="form-select">
                    <option value="">@SelectShipyardOption</option>
                </select>
                <span asp-validation-for="ShipyardName" class="text-danger small"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Budget"></label>
                <div class="input-group">
                    <input asp-for="Budget" step="any" type="number" class="form-control" />
                    <span class="input-group-text">USD</span>
                </div>
                <span asp-validation-for="Budget" class="text-danger small"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Description"></label>
                <textarea asp-for="Description" class="form-control" rows="4"></textarea>
                <span asp-validation-for="Description" class="text-danger small"></span>
            </div>
            <div class="entity-actions">
                <partial name="_ActionButton" model="ActionButton.SaveSubmit()" />
                <a asp-action="Index" class="btn-back">@BackToListCaption</a>
            </div>
        </form>
    </div>
</div>

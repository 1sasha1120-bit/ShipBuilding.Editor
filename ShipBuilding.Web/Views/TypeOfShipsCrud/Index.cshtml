@model ShipBuilding.Web.Models.TypeOfShipModels.TypeOfShipSelectionModel
@{ ViewData["Title"] = "Типи суден"; }

@section Styles {
    <link rel="stylesheet" href="~/css/entity.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/TreeStyle.css" asp-append-version="true" />
}

@if (TempData["message"] != null)
{
    <div class="alert alert-success alert-dismissible fade show">
        @TempData["message"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show">
        @TempData["error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="d-flex align-items-center gap-3 mb-3">
    <h1 class="mb-0"><i class="fa-solid fa-sitemap"></i> Типи суден</h1>
    <partial name="_ActionButton" model='ActionButtonModel.CreateLink("btn-sm ms-auto")' />
    <a asp-controller="Admin" asp-action="Index" class="btn btn-outline-secondary btn-sm">← Адмін</a>
</div>

<partial name="_IndexFilter" model="@Model.Filter" />

@if (Model.IsFiltered)
{
    @* Пласка таблиця при активному фільтрі*@
    <div class="entity-card">
        <div class="entity-card-body p-0">
            <table class="table table-hover mb-0">
                <thead class="table-light">
                    <tr>
                        <th>@Html.DisplayNameFor(m => m.SelectedObject.Name)</th>
                        <th>@Html.DisplayNameFor(m => m.SelectedObject.TypeCode)</th>
                        <th>@Html.DisplayNameFor(m => m.SelectedObject.ParentName)</th>
                        <th class="col-actions-160"></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.FilteredData)
                    {
                        <tr>
                            <td class="tree-depth-cell" style="--depth:@item.Depth">
                                @item.Name
                            </td>
                            <td>
                                @if (!string.IsNullOrWhiteSpace(item.TypeCode))
                                {<span class="tree-code">@item.TypeCode</span>}
                            </td>
                            <td>@(item.ParentName ?? "—")</td>
                            <td>
                                <partial name="_RowActions" model="item.Id" />
                            </td>
                        </tr>
                    }
                    @if (!Model.FilteredData.Any())
                    {
                        <tr><td colspan="4" class="text-center text-muted py-4">Нічого не знайдено</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
else
{
    @* DOM-дерево: ul/li + details/summary*@
    <div class="entity-card">
        <div class="entity-card-body p-3">
            <div class="tree-ctrl">
                <span class="text-muted small">Ієрархія типів:</span>
                <a asp-action="Index" asp-route-expand="true" class="tree-ctrl-btn"><i class="bi bi-plus-square"></i> Розгорнути всі</a>
                <a asp-action="Index" asp-route-expand="false" class="tree-ctrl-btn"><i class="bi bi-dash-square"></i> Згорнути всі</a>
            </div>

            <ul class="ship-tree">
                @{
                    var treeViewData = new ViewDataDictionary(ViewData) { ["ExpandAll"] = Model.ExpandAll };
                }
                @foreach (var root in Model.TreeData)
                {
                    <partial name="_TreeNode" model="root" view-data="treeViewData" />
                }
            </ul>

            @if (!Model.TreeData.Any())
            {
                <p class="text-muted text-center py-4">
                    Немає жодного типу судна. <a asp-action="Create">Створити перший →</a>
                </p>
            }
        </div>
    </div>
}

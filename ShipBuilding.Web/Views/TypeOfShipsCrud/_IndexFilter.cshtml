@using ShipBuilding.Web.Models.TypeOfShipModels
@model ShipBuilding.Web.Models.TypeOfShipModels.TypeOfShipsFilter

<form asp-action="Index" method="get">
    <table class="table">
        <thead>
            <tr>
                <th>
                    @Html.DisplayNameFor(model => model.Name)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.TypeCode)
                </th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            <tr>
                <td>
                    <input asp-for="Name" class="form-control" />
                </td>
                <td>
                    <input asp-for="TypeCode" class="form-control" />
                </td>
                <td>
                    <button type="submit" class="btn btn-primary">Пошук</button>
                    <a asp-action="Index" class="btn btn-outline-secondary">Очистити</a>
                </td>
            </tr>
        </tbody>
    </table>
</form>

@model ShipBuilding.Web.ViewModels.Ships.ShipSelectionViewModel
@{ ViewData["Title"] = ShipsHeader; }

@section Styles {
    <link rel="stylesheet" href="~/css/entity.css" asp-append-version="true" />
}

@if (TempData["message"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["message"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="d-flex align-items-center gap-3 mb-3">
    <h1 class="mb-0"><i class="fa-solid fa-ship"></i> @ShipsHeader</h1>
    <partial name="_ActionButton" model='ActionButtonViewModel.CreateLink("btn-sm ms-auto")' />
    <a asp-controller="Admin" asp-action="Index" class="btn btn-outline-secondary btn-sm">@BackToAdminCaption</a>
</div>

<partial name="_IndexFilter" model="@Model.Filter" />

<div class="entity-card">
    <div class="entity-card-body p-0">
        <table class="table table-hover mb-0">
            <thead class="table-light">
                <tr>
                    <th>
                        <a asp-action="Index"
                               asp-route-Name="@Model.Filter.Name"
                               asp-route-ShipyardName="@Model.Filter.ShipyardName"
                               asp-route-RegistrationNumber="@Model.Filter.RegistrationNumber"
                               asp-route-LaunchDateMin="@Model.Filter.LaunchDateMin"
                               asp-route-LaunchDateMax="@Model.Filter.LaunchDateMax"
                               asp-route-TypeOfShipName="@Model.Filter.TypeOfShipName"
                               asp-route-sortBy="Name" asp-route-order="@Model.NextOrder("Name")" class="text-decoration-none text-dark fw-bold">
                            @NameCaption <i class="bi bi-arrow-down-up"></i>
                        </a>
                    </th>
                    <th>
                        <a asp-action="Index"                             
                           asp-route-Name="@Model.Filter.Name"
                           asp-route-ShipyardName="@Model.Filter.ShipyardName"
                           asp-route-RegistrationNumber="@Model.Filter.RegistrationNumber"
                           asp-route-LaunchDateMin="@Model.Filter.LaunchDateMin"
                           asp-route-LaunchDateMax="@Model.Filter.LaunchDateMax"
                           asp-route-TypeOfShipName="@Model.Filter.TypeOfShipName"
                           asp-route-sortBy="RegistrationNumber" asp-route-order="@Model.NextOrder("RegistrationNumber")" class="text-decoration-none text-dark fw-bold">
                            IMO <i class="bi bi-arrow-down-up"></i>
                        </a>
                    </th>
                    <th>
                        <a asp-action="Index" 
                           asp-route-Name="@Model.Filter.Name"
                           asp-route-ShipyardName="@Model.Filter.ShipyardName"
                           asp-route-RegistrationNumber="@Model.Filter.RegistrationNumber"
                           asp-route-LaunchDateMin="@Model.Filter.LaunchDateMin"
                           asp-route-LaunchDateMax="@Model.Filter.LaunchDateMax"
                           asp-route-TypeOfShipName="@Model.Filter.TypeOfShipName"
                           asp-route-sortBy="LaunchDate" asp-route-order="@Model.NextOrder("LaunchDate")" class="text-decoration-none text-dark fw-bold">
                            @ShortLaunchDateCaption <i class="bi bi-arrow-down-up"></i>
                       </a>
                    </th>
                    <th>
                        <a asp-action="Index" 
                           asp-route-Name="@Model.Filter.Name"
                           asp-route-ShipyardName="@Model.Filter.ShipyardName"
                           asp-route-RegistrationNumber="@Model.Filter.RegistrationNumber"
                           asp-route-LaunchDateMin="@Model.Filter.LaunchDateMin"
                           asp-route-LaunchDateMax="@Model.Filter.LaunchDateMax"
                           asp-route-TypeOfShipName="@Model.Filter.TypeOfShipName"
                           asp-route-sortBy="ShipyardName" asp-route-order="@Model.NextOrder("ShipyardName")" class="text-decoration-none text-dark fw-bold">
                            @ShipyardCaption <i class="bi bi-arrow-down-up"></i>
                        </a>
                    </th>
                    <th>
                        <a asp-action="Index" 
                           asp-route-Name="@Model.Filter.Name"
                           asp-route-ShipyardName="@Model.Filter.ShipyardName"
                           asp-route-RegistrationNumber="@Model.Filter.RegistrationNumber"
                           asp-route-LaunchDateMin="@Model.Filter.LaunchDateMin"
                           asp-route-LaunchDateMax="@Model.Filter.LaunchDateMax"
                           asp-route-TypeOfShipName="@Model.Filter.TypeOfShipName"
                           asp-route-sortBy="TypeOfShipName" asp-route-order="@Model.NextOrder("TypeOfShipName")" class="text-decoration-none text-dark fw-bold">
                            @ShortTypeCaption <i class="bi bi-arrow-down-up"></i>
                        </a>
                    </th>
                    <th class="col-actions-200"></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.FilteredData)
                {
                    <tr>
                        <td class="fw-500">@item.Name</td>
                        <td>
                            @if (!string.IsNullOrWhiteSpace(item.RegistrationNumber))
                            { <span class="field-badge">@item.RegistrationNumber</span> }
                        </td>
                        <td>@item.LaunchDate?.ToString("dd.MM.yyyy")</td>
                        <td>@item.ShipyardName</td>
                        <td>@item.TypeOfShipName</td>
                        <td>
                            <partial name="_RowActions" model="item.Id" />
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

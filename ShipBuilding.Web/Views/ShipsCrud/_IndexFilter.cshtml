@using ShipBuilding.Types
@model ShipBuilding.Web.Models.ShipModels.ShipsFilter

<form asp-action="Index" method="get">
    <table class="table">
        <thead>
            <tr>
                <th>
                    <label asp-for="Name"></label>
                   @*  @Html.DisplayNameFor(model => model.Name) *@
                </th>
                <th>
                    <label asp-for="RegistrationNumber"></label>
                </th>
                <th>
                    <label asp-for="LaunchDateMin"></label>
                </th>
                <th>
                    <label asp-for="ShipyardName"></label>
                </th>
                <th>
                    <label asp-for="TypeOfShipName"></label>
                </th>

                <th></th>
            </tr>
        </thead>
        <tbody>
            <tr>
                <td>
                    <input asp-for="Name" class="form-control" />
                </td>
                <td>
                    <input asp-for="RegistrationNumber" class="form-control" />
                </td>
                
                <td>
                    @RangeFromCaption <input asp-for="LaunchDateMin" class="form-control" /><br />
                    @RangeToCaption <input asp-for="LaunchDateMax" class="form-control" />
                </td>
                <td>
                    <select asp-for="ShipyardName" class="form-select" asp-items="Model.ShipyardNamesList">
                        <option value="">@AllShipyardsOption</option>
                    </select>
                </td>
                <td>
                    <select asp-for="TypeOfShipName" class="form-select" asp-items="Model.TypeOfShipNamesList">
                        <option value="">@AllTypesOfShipsOption</option>
                    </select>
                </td>
                <td>
                    <button type="submit" class="btn btn-primary">@SearchCaption</button>
                    <a asp-action="Index" class="btn btn-outline-secondary">@ClearCaption</a>
                </td>
                
            </tr>
        </tbody>
    </table>
</form>



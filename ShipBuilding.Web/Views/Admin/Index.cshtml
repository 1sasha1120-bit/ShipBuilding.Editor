@using ShipBuilding.Web.Models.Extensions
@using static ShipBuilding.Settings.UiSettings
@model ShipBuilding.Web.Models.AdminPanelModels.AdminPanelModel
@{
    ViewData["Title"] = AdminPanelCaption;
}

@section Styles {
    <link rel="stylesheet" href="~/css/entity.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />
}

<div class="d-flex align-items-center gap-3 mb-4">
    <div>
        <h1 class="mb-1">@AdminPanelCaption</h1>
        <p class="text-muted mb-0">@SubjectAreaTitle · @AdminPanelSubtitle</p>
    </div>
    <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary btn-sm ms-auto">
        <i class="bi bi-house"></i> @HomePageCaption
    </a>
</div>

<div class="admin-grid mb-4">
    @foreach (var s in Model.Sections)
    {
        <div class="admin-tile">
            <a asp-controller="@s.Controller" asp-action="Index" class="admin-tile-main">
                <div class="admin-tile-icon"><i class="@s.IconCss"></i></div>
                <div class="admin-tile-title">@s.Title</div>
                <div class="admin-tile-sub">@s.Description</div>
                <div class="admin-tile-count">
                    <strong>@s.Count</strong> <span>@Html.DisplayNameFor(m => m.Sections[0].Count).ToLower()</span>
                </div>
            </a>
            <div class="admin-tile-actions">
                <a asp-controller="@s.Controller" asp-action="Index" class="btn btn-sm btn-outline-secondary">
                    <i class="bi bi-list-ul"></i> @OpenListCaption
                </a>
                <partial name="_ActionButton" model='ActionButtonModel.CreateLink("btn-sm", s.Controller)' />
            </div>
        </div>
    }
</div>

<div class="entity-card">
    <div class="entity-card-header">
        <h2 class="admin-card-title">@Html.DisplayNameFor(m => m.IncompleteRecords)</h2>
        <span class="badge rounded-pill @(Model.IncompleteRecords.Count == 0 ? "bg-success" : "bg-warning text-dark")">@Model.IncompleteRecords.Count</span>
    </div>
    <div class="entity-card-body p-0">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>@Html.DisplayNameFor(m => m.IncompleteRecords[0].Section)</th>
                    <th>@Html.DisplayNameFor(m => m.IncompleteRecords[0].Name)</th>
                    <th>@Html.DisplayNameFor(m => m.IncompleteRecords[0].MissingFields)</th>
                    <th class="col-actions-160"></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var r in Model.IncompleteRecords)
                {
                    <tr>
                        <td class="text-muted text-nowrap">@r.Section</td>
                        <td><a asp-controller="@r.Kind.ControllerFor()" asp-action="Details" asp-route-id="@r.Id">@(r.Name ?? "—")</a></td>
                        <td>
                            @foreach (var field in r.MissingFields)
                            {
                                <span class="admin-missing">@field</span>
                            }
                        </td>
                        <td class="text-end">
                            <partial name="_ActionButton" model='ActionButtonModel.EditLink(r.Id, "btn-sm", r.Kind.ControllerFor())' />
                        </td>
                    </tr>
                }
                @if (Model.IncompleteRecords.Count == 0)
                {
                    <tr><td colspan="4" class="text-center text-muted py-4">@AllRecordsCompleteMessage</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>

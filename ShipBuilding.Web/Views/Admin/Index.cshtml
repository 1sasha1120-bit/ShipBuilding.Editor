@{
    ViewData["Title"] = AdminPanelCaption;
}

@section Styles {
    <link rel="stylesheet" href="~/css/entity.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />
}

<div class="d-flex align-items-center gap-3 mb-4">
    <div>
        <h1 class="mb-1">@AdminPanelCaption</h1>
        <p class="text-muted mb-0">@SubjectAreaTitle · @AdminPanelSubtitle</p>
    </div>
    <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary btn-sm ms-auto">
        <i class="bi bi-house"></i> @HomePageCaption
    </a>
</div>

<div class="admin-grid">
    <div class="admin-tile">
        <a asp-controller="TypeOfShipsCrud" asp-action="Index" class="admin-tile-main">
            <div class="admin-tile-icon"><i class="fa-solid fa-sitemap"></i></div>
            <div class="admin-tile-title">@TypeOfShipsHeader</div>
            <div class="admin-tile-sub">@TypeOfShipsDescription</div>
        </a>
        <div class="admin-tile-actions">
            <a asp-controller="TypeOfShipsCrud" asp-action="Index" class="btn btn-sm btn-outline-secondary">
                <i class="bi bi-list-ul"></i> @OpenListCaption
            </a>
            <partial name="_ActionButton" model='ActionButtonViewModel.CreateLink("btn-sm", "TypeOfShipsCrud")' />
        </div>
    </div>

    <div class="admin-tile">
        <a asp-controller="ShipyardsCrud" asp-action="Index" class="admin-tile-main">
            <div class="admin-tile-icon"><i class="fa-solid fa-industry"></i></div>
            <div class="admin-tile-title">@ShipyardsHeader</div>
            <div class="admin-tile-sub">@ShipyardsDescription</div>
        </a>
        <div class="admin-tile-actions">
            <a asp-controller="ShipyardsCrud" asp-action="Index" class="btn btn-sm btn-outline-secondary">
                <i class="bi bi-list-ul"></i> @OpenListCaption
            </a>
            <partial name="_ActionButton" model='ActionButtonViewModel.CreateLink("btn-sm", "ShipyardsCrud")' />
        </div>
    </div>

    <div class="admin-tile">
        <a asp-controller="ShipProjectsCrud" asp-action="Index" class="admin-tile-main">
            <div class="admin-tile-icon"><i class="fa-solid fa-compass-drafting"></i></div>
            <div class="admin-tile-title">@ProjectsHeader</div>
            <div class="admin-tile-sub">@ProjectsDescription</div>
        </a>
        <div class="admin-tile-actions">
            <a asp-controller="ShipProjectsCrud" asp-action="Index" class="btn btn-sm btn-outline-secondary">
                <i class="bi bi-list-ul"></i> @OpenListCaption
            </a>
            <partial name="_ActionButton" model='ActionButtonViewModel.CreateLink("btn-sm", "ShipProjectsCrud")' />
        </div>
    </div>

    <div class="admin-tile">
        <a asp-controller="ShipsCrud" asp-action="Index" class="admin-tile-main">
            <div class="admin-tile-icon"><i class="fa-solid fa-ship"></i></div>
            <div class="admin-tile-title">@ShipsHeader</div>
            <div class="admin-tile-sub">@ShipsDescription</div>
        </a>
        <div class="admin-tile-actions">
            <a asp-controller="ShipsCrud" asp-action="Index" class="btn btn-sm btn-outline-secondary">
                <i class="bi bi-list-ul"></i> @OpenListCaption
            </a>
            <partial name="_ActionButton" model='ActionButtonViewModel.CreateLink("btn-sm", "ShipsCrud")' />
        </div>
    </div>
</div>

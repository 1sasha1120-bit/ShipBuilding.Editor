@model PagedList<ShipBuilding.Web.Models.ShipProjectModels.ShipProjectBrowsingModel>
@{
    ViewData["Title"] = ProjectsHeader;

    static string Money(decimal value) =>
        value.ToString("C0", System.Globalization.CultureInfo.GetCultureInfo("en-US"));
}

@section Styles {
    <link rel="stylesheet" href="~/css/entity.css" asp-append-version="true" />
}

<div class="d-flex align-items-center gap-3 mb-3">
    <div>
        <h1 class="mb-1"><i class="fa-solid fa-compass-drafting"></i> @ProjectsHeader</h1>
        <p class="text-muted mb-0">@BrowseSubtitle</p>
    </div>
    <a asp-action="Index" class="btn btn-outline-secondary btn-sm ms-auto">@BackToHomeCaption</a>
</div>

<div class="entity-card">
    <div class="entity-card-body p-0">
        <table class="table table-hover mb-0">
            <thead class="table-light">
                <tr>
                    <th>@Html.DisplayNameFor(m => m.Items[0].Name)</th>
                    <th>@Html.DisplayNameFor(m => m.Items[0].ProjectCode)</th>
                    <th>@Html.DisplayNameFor(m => m.Items[0].ShipyardName)</th>
                    <th class="text-end">@Html.DisplayNameFor(m => m.Items[0].Budget)</th>
                    <th>@Html.DisplayNameFor(m => m.Items[0].Description)</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.Items)
                {
                    <tr>
                        <td class="fw-medium">@item.Name</td>
                        <td>
                            @if (!string.IsNullOrWhiteSpace(item.ProjectCode))
                            { <span class="field-badge">@item.ProjectCode</span> }
                            else { <span class="text-muted">—</span> }
                        </td>
                        <td>@(item.ShipyardName ?? "—")</td>
                        <td class="text-end text-nowrap">@(item.Budget.HasValue ? Money(item.Budget.Value) : "—")</td>
                        <td class="text-muted small">@(item.Description ?? "—")</td>
                    </tr>
                }
                @if (Model.Items.Count == 0)
                {
                    <tr><td colspan="5" class="text-center text-muted py-4">@NoProjectsFoundMessage</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>

<partial name="_Pager" model="Model.Paging" />

@model PagedList<ShipBuilding.Web.Models.Ships.ShipBrowsingModel>
@{ ViewData["Title"] = ShipsHeader; }

@section Styles {
    <link rel="stylesheet" href="~/css/entity.css" asp-append-version="true" />
}

<div class="d-flex align-items-center gap-3 mb-3">
    <div>
        <h1 class="mb-1"><i class="fa-solid fa-ship"></i> @ShipsHeader</h1>
        <p class="text-muted mb-0">@BrowseSubtitle</p>
    </div>
    <a asp-action="Index" class="btn btn-outline-secondary btn-sm ms-auto">@BackToHomeCaption</a>
</div>

<div class="entity-card">
    <div class="entity-card-body p-0">
        <table class="table table-hover mb-0">
            <thead class="table-light">
                <tr>
                    <th>@Html.DisplayNameFor(m => m.Items[0].Name)</th>
                    <th>@Html.DisplayNameFor(m => m.Items[0].RegistrationNumber)</th>
                    <th>@Html.DisplayNameFor(m => m.Items[0].LaunchDate)</th>
                    <th>@Html.DisplayNameFor(m => m.Items[0].ShipyardName)</th>
                    <th>@Html.DisplayNameFor(m => m.Items[0].TypeOfShipName)</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.Items)
                {
                    <tr>
                        <td class="fw-medium">@item.Name</td>
                        <td>
                            @if (!string.IsNullOrWhiteSpace(item.RegistrationNumber))
                            { <span class="field-badge">@item.RegistrationNumber</span> }
                            else { <span class="text-muted">—</span> }
                        </td>
                        <td class="text-nowrap">@(item.LaunchDate?.ToString("dd.MM.yyyy") ?? "—")</td>
                        <td>@(item.ShipyardName ?? "—")</td>
                        <td>@(item.TypeOfShipName ?? "—")</td>
                    </tr>
                }
                @if (Model.Items.Count == 0)
                {
                    <tr><td colspan="5" class="text-center text-muted py-4">@NoShipsMessage</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>

<partial name="_Pager" model="Model.Paging" />
